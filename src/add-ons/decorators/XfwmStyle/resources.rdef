resource("be:decor:info") message('deco') {
	"name"				= "xfwm4 style",
	"authors"			= "ablyssx74",
	"short_descr"		= "Draws windows with an xfwm4 theme (a decorator style)",
	"long_descr"		= "Draws window frames, title bars and buttons from the pictures of an xfwm4 theme, as a decorator style (RenkuOS/Source#626): it does not have to be built again for each build of app_server. The theme is the one named in the add-on's file name (XfwmStyle-b6 is the b6 theme); the title bar's tab does not slide.",
	"lic_url"			= "",
	"lic_name"			= "MIT",
	"support_url"		= "http://www.haiku-os.org/",
	float "version"		= 1.0
};
