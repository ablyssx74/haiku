# Starts the snake-trail Tracker and Deskbar instead of the system's. The launch daemon reads it from
# /boot/system/data/user_launch, so the package must be installed for the system, not for "home".
#
# Everything is inside "target desktop" on purpose. The launch daemon applies its files in the order the
# packages were installed, so this file may be read before the system's own. A service named here but not
# yet defined would be created outside the desktop target and then never start; inside the target it is
# created properly and the system's file simply fills in the rest.
target desktop {
	service x-vnd.Be-TRAK {
		launch /system/apps/SnakeTracker/Tracker
	}

	service x-vnd.Be-TSKB {
		launch /system/apps/SnakeTracker/Deskbar
	}

	# If this file was read before the system's, the system's launch lines replace the two above. This job
	# checks what the launch daemon is going to start and hands over to the snake-trail ones if it is the
	# system's. It must not "require" the two services: stopping a service stops the jobs that require it.
	job snaketracker-handoff {
		launch /bin/sh /system/apps/SnakeTracker/handoff
		on initial_volumes_mounted
	}
}
